          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene 3 riesgos', () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar el riesgo agregado",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/riesgos/{{riesgoAgregadoId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "riesgos",
                "{{riesgoAgregadoId}}",
                "cancelar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Endoso de exclusión que devuelve; la póliza sigue vigente', () => {",
                  "  pm.expect(r.poliza.endoso.tipo).to.eql('EXCLUSION');",
                  "  pm.expect(r.poliza.endoso.claseMovimiento).to.eql('DEVOLUCION');",
                  "  pm.expect(r.poliza.estado).to.eql('VIGENTE');",
                  "  pm.expect(r.riesgo.estado).to.eql('CANCELADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar la póliza colectiva",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/polizas/{{polizaColectivaId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "polizas",
                "{{polizaColectivaId}}",
                "cancelar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('Póliza y riesgos cancelados', () => {",
                  "  pm.expect(p.estado).to.eql('CANCELADA');",
                  "  pm.expect(p.endoso.tipo).to.eql('CANCELACION');",
                  "  p.riesgos.forEach(r => pm.expect(r.estado).to.eql('CANCELADO'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
